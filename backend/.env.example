# HealthSphere AI — Backend Environment Variables
# Copy to .env and fill in your values. Never commit .env.

APP_ENV=development
APP_NAME=HealthSphere AI
BASE_URL=http://localhost:8000

# Database — SQLite for local development
# Production: postgresql://user:password@host:5432/database
DATABASE_URL=sqlite:///./healthsphere.db

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — comma separated or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI provider (optional — explanation layer falls back to templates when unset)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Seed admin credentials (used by seed script only)
SEED_ADMIN_EMAIL=admin@healthsphere.ai
SEED_ADMIN_PASSWORD=admin123